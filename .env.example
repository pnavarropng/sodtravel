# API key de OpenAI, usada para transcribir el audio con Whisper
OPENAI_API_KEY=

# API key de Anthropic, usada para detectar los mejores momentos (highlights)
ANTHROPIC_API_KEY=

# Carpeta donde se guardan los videos subidos, transcripciones y clips generados.
# Por defecto es ./data en la raíz del proyecto.
DATA_ROOT=
